<% content_for :title, "Users" %>

<div class="page-header">
  <h1>Users</h1>
  <%= link_to "New User", new_user_path, class: "button primary-button" %>
</div>

<% if notice.present? %>
  <p class="notice"><%= notice %></p>
<% end %>

<div id="users">
  <% @users.each do |user| %>
    <article class="book-card">
      <%= render user %>
      <div class="book-actions">
        <%= link_to "Show", user_path(user) %>
        <%= link_to "Edit", edit_user_path(user) %>
        <%= button_to "Delete", user_path(user), method: :delete, class: "link-button danger-link" %>
      </div>
    </article>
  <% end %>
</div>
