<% content_for :title, "Home" %>

<div class="page-header">
  <div>
    <h1>Book Collection</h1>
    <p class="subtitle">Keep track of the books in your collection.</p>
  </div>

  <%= link_to "Add a Book", new_book_path, class: "button primary-button" %>
</div>

<% if notice.present? %>
  <p class="notice"><%= notice %></p>
<% end %>

<div id="books">
  <% @books.each do |book| %>
    <article class="book-card">
      <%= render book %>
      <div class="book-actions">
        <%= link_to "Show", book_path(book) %>
        <%= link_to "Update", edit_book_path(book) %>
        <%= link_to "Delete", delete_book_path(book), class: "danger-link" %>
      </div>
    </article>
  <% end %>

  <% if @books.empty? %>
    <p class="empty-message">No books have been added yet.</p>
  <% end %>
</div>
