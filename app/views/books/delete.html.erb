<% content_for :title, "Delete a Book" %>

<h1>Delete a Book</h1>

<div class="delete-card">
  <p>Are you sure you want to delete this book?</p>

  <%= render @book %>

  <div class="delete-actions">
    <%= button_to "Delete Book", book_path(@book), method: :delete, class: "button danger-button" %>
    <%= link_to "Cancel", root_path, class: "button secondary-button" %>
  </div>
</div>

<div class="page-links">
  <%= link_to "Back to Home", root_path %>
</div>
